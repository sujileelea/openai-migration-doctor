{
  "name": "migration-doctor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "tsc -b --pretty false && vitest run",
    "test:watch": "vitest",
    "benchmark": "tsc -b benchmarks --pretty false && node benchmarks/dist/run.js",
    "python:lock:check": "uv lock --check --project packages/language-python",
    "python:sync": "uv sync --project packages/language-python --locked",
    "python:check": "uv run --project packages/language-python --locked python -m compileall -q packages/language-python/python",
    "measure:python": "node packages/language-python/scripts/measure-performance.mjs",
    "validate:sarif": "tsc -b --pretty false && node scripts/validate-sarif.mjs",
    "doctor": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@migration-doctor/codex-adapter": "workspace:*",
    "@migration-doctor/core": "workspace:*",
    "@migration-doctor/language-python": "workspace:*",
    "@migration-doctor/language-typescript": "workspace:*",
    "@migration-doctor/reporters": "workspace:*",
    "@types/node": "24.3.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
