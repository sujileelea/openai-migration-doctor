{
  "$schema": "https://biomejs.dev/schemas/2.2.2/schema.json",
  "files": {
    "includes": [
      "package.json",
      "packages/*/package.json",
      "packages/*/src/**",
      "tests/**",
      "*.json",
      "*.ts",
      "*.yaml",
      "data/**",
      "migration.lock"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
