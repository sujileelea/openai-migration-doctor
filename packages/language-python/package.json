{
  "name": "@migration-doctor/language-python",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "python",
    "pyproject.toml",
    "uv.lock"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "python:sync": "uv sync --locked",
    "measure:python": "node ./scripts/measure-performance.mjs"
  },
  "dependencies": {
    "@migration-doctor/core": "workspace:*"
  }
}
